{
  "name": "@local/dsh-workhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkHub - personal work hub panel for DingTalk data via DWS (Milestone 1 spike)",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
