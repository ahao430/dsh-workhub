{
  "name": "@ahao430/dsh-workhub",
  "version": "0.1.0",
  "description": "Personal work-intelligence hub for DingTalk and Yunxiao inside DeepSeek Harness: syncs work data into local SQLite and exposes dashboards, a work calendar, project analysis, reports and workhub_* agent tools.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "ahao430",
    "url": "https://github.com/ahao430"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahao430/dsh-workhub.git"
  },
  "bugs": {
    "url": "https://github.com/ahao430/dsh-workhub/issues"
  },
  "homepage": "https://github.com/ahao430/dsh-workhub#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dingtalk",
    "yunxiao",
    "workhub",
    "productivity",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "icon.svg",
    "screenshots.json",
    "docs/screens/*.png",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "antd": "^6.7.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
